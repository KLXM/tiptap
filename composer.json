{
    "name": "klxm/tiptap",
    "description": "WYSIWYG- und Markdown-Editor für REDAXO 6 auf Basis von TipTap: Profile mit Toolbar-Builder, Import/Export, Linkmap und Medienpool, Collections, Frontend und erweiterbar durch andere AddOns",
    "type": "redaxo-addon",
    "license": "MIT",
    "keywords": [
        "redaxo",
        "redaxo-addon",
        "redaxo6",
        "editor",
        "wysiwyg",
        "markdown",
        "tiptap"
    ],
    "homepage": "https://klxm.de",
    "authors": [
        {
            "name": "Thomas Skerbis",
            "homepage": "https://github.com/skerbis",
            "role": "Lead"
        },
        {
            "name": "KLXM Crossmedia GmbH",
            "homepage": "https://klxm.de"
        }
    ],
    "require": {
        "php": "^8.5",
        "redaxo/core": "^6.0@dev"
    },
    "autoload": {
        "psr-4": {
            "Klxm\\Tiptap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Klxm\\Tiptap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "redaxo": {
            "addon-class": "Klxm\\Tiptap\\TiptapAddon"
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
