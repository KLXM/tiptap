{
    "name": "friendsofredaxo/tiptap",
    "description": "WYSIWYG- und Markdown-Editor für REDAXO 6 auf Basis von TipTap: Profile mit Toolbar-Builder, Import/Export, Linkmap und Medienpool, Collections, Frontend und erweiterbar durch andere AddOns",
    "type": "redaxo-addon",
    "license": "MIT",
    "keywords": ["redaxo", "redaxo-addon", "redaxo6", "editor", "wysiwyg", "markdown", "tiptap"],
    "homepage": "https://github.com/FriendsOfREDAXO/tiptap",
    "authors": [
        {"name": "Thomas Skerbis", "homepage": "https://github.com/skerbis", "role": "Lead"},
        {"name": "Friends Of REDAXO", "homepage": "https://friendsofredaxo.github.io"}
    ],
    "support": {
        "issues": "https://github.com/FriendsOfREDAXO/tiptap/issues",
        "source": "https://github.com/FriendsOfREDAXO/tiptap"
    },
    "require": {
        "php": "^8.5",
        "redaxo/core": "^6.0@dev"
    },
    "autoload": {
        "psr-4": {"FriendsOfRedaxo\\Tiptap\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"FriendsOfRedaxo\\Tiptap\\Tests\\": "tests/"}
    },
    "extra": {
        "redaxo": {"addon-class": "FriendsOfRedaxo\\Tiptap\\TiptapAddon"},
        "branch-alias": {"dev-main": "1.x-dev"}
    }
}
