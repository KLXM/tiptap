{
    "name": "klxm/tiptap",
    "description": "WYSIWYG and Markdown editor for REDAXO 6 based on TipTap: profiles with toolbar builder, import/export, linkmap and media pool, collections, frontend use and extensible by other addons",
    "type": "redaxo-addon",
    "license": "MIT",
    "keywords": [
        "redaxo",
        "redaxo-addon",
        "redaxo6",
        "editor",
        "wysiwyg",
        "markdown",
        "tiptap"
    ],
    "homepage": "https://klxm.de",
    "authors": [
        {
            "name": "Thomas Skerbis",
            "homepage": "https://github.com/skerbis",
            "role": "Lead"
        },
        {
            "name": "KLXM Crossmedia GmbH",
            "homepage": "https://klxm.de"
        }
    ],
    "support": {
        "issues": "https://github.com/KLXM/tiptap/issues",
        "source": "https://github.com/KLXM/tiptap"
    },
    "require": {
        "php": "^8.5",
        "redaxo/core": "^6.0@dev",
        "klxm/klxm_meta": "^1.0@dev"
    },
    "require-dev": {
        "redaxo/php-cs-fixer-config": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Klxm\\Tiptap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Klxm\\Tiptap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "redaxo": {
            "addon-class": "Klxm\\Tiptap\\TiptapAddon"
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "suggest": {
        "klxm/video_editor": "Poster, web versions and subtitles for videos from the media pool"
    }
}
